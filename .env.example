# =================================================================
# COLLEGE RUNNER BACKEND CONFIGURATION
# =================================================================

# Server Port
PORT=5000

# JSON Web Token Secret (used for signing app user authentication tokens)
JWT_SECRET=college_runner_jwt_super_secret_key_change_in_production_2026

# -----------------------------------------------------------------
# NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------
# Get your connection string from https://console.neon.tech
# Go to: Your Project -> Connection Details -> copy the connection string
DATABASE_URL=YOUR_NEON_DATABASE_URL_HERE

# -----------------------------------------------------------------
# ZOOM VIDEO SDK CREDENTIALS
# -----------------------------------------------------------------
# Create a Zoom Video SDK app at https://marketplace.zoom.us/
# 1. Sign in to Zoom App Marketplace -> Develop -> Build App
# 2. Choose "Video SDK" app type
# 3. Copy your SDK Key (Client ID) and SDK Secret (Client Secret) below:
ZOOM_SDK_KEY=YOUR_ZOOM_SDK_KEY_OR_CLIENT_ID_HERE
ZOOM_SDK_SECRET=YOUR_ZOOM_SDK_SECRET_HERE

# Optional: Zoom Webhook Secret Token (for real-time meeting status events)
ZOOM_WEBHOOK_SECRET_TOKEN=YOUR_ZOOM_WEBHOOK_SECRET_TOKEN_HERE
