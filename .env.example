# Copy this file to .env for local server development, then fill in the values.
NODE_ENV=development
PORT=5000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Exact browser app origin(s), with no path or trailing slash.
CORS_ORIGINS=
FRONTEND_URL=

# Existing Zoom Meetings subscription. Do not use Zoom Video SDK credentials.
# Server-to-Server OAuth app (same Zoom account you already pay for):
#   marketplace.zoom.us -> Develop -> Build App -> Server-to-Server OAuth
#   App Credentials page: Account ID, Client ID, Client Secret
# USER_ID is the licensed host's Zoom email (or user id) on that account.
ZOOM_ACCOUNT_1_LABEL=Zoom account 1
ZOOM_ACCOUNT_1_ACCOUNT_ID=
ZOOM_ACCOUNT_1_USER_ID=
ZOOM_ACCOUNT_1_CLIENT_ID=
ZOOM_ACCOUNT_1_CLIENT_SECRET=
# Meeting SDK (General app, Features -> Embed -> Meeting SDK).
# Basic Information / App Credentials: Client ID -> SDK_KEY, Client Secret -> SDK_SECRET.
# Legacy names ZOOM_SDK_KEY / ZOOM_SDK_SECRET are accepted for account 1 if these are empty.
ZOOM_ACCOUNT_1_SDK_KEY=
ZOOM_ACCOUNT_1_SDK_SECRET=

# Zoom meeting-host account 2. Create a separate Server-to-Server OAuth app
# and Meeting SDK app under the second Zoom account, then enter their values.
# ACCOUNT_ID / CLIENT_ID / CLIENT_SECRET: Server-to-Server OAuth app credentials.
# USER_ID: Zoom user ID or email for the host on account 2.
# SDK_KEY / SDK_SECRET: Meeting SDK app Client ID / Client Secret for account 2.
ZOOM_ACCOUNT_2_LABEL=Zoom account 2
ZOOM_ACCOUNT_2_ACCOUNT_ID=
ZOOM_ACCOUNT_2_USER_ID=
ZOOM_ACCOUNT_2_CLIENT_ID=
ZOOM_ACCOUNT_2_CLIENT_SECRET=
ZOOM_ACCOUNT_2_SDK_KEY=
ZOOM_ACCOUNT_2_SDK_SECRET=

# Separate user-managed OAuth app used when participants connect their own Zoom accounts.
# Redirect URL must exactly match this app's OAuth Redirect URL and Allow List in Zoom.
ZOOM_USER_OAUTH_CLIENT_ID=
ZOOM_USER_OAUTH_CLIENT_SECRET=
ZOOM_USER_OAUTH_REDIRECT_URI=https://galaxy-college-server.vercel.app/api/v1/auth/zoom/callback
# Generate a random 32-byte key and keep it private (example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
ZOOM_USER_OAUTH_ENCRYPTION_KEY=
# guest joins the school's licensed meeting. zak/obf are only for a linked personal Zoom user.
ZOOM_PARTICIPANT_AUTH_MODE=guest
